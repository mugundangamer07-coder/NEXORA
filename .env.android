# Used only by `npm run build:android` (Vite loads it via --mode android).
# The Android app bundles its pages inside the APK, so it needs the backend's
# full address. This value ends up inside the APK — put NO secrets here.
VITE_API_BASE_URL=https://nexora-omega-woad.vercel.app

# To test a debug build against the server on your PC instead, create
# .env.android.local (git-ignored; it overrides this file) containing:
#   VITE_API_BASE_URL=http://127.0.0.1:3001
# then run `adb reverse tcp:3001 tcp:3001`. Use 127.0.0.1, not "localhost":
# Capacitor serves the app itself from "localhost" and intercepts those
# requests. Plain http:// to 127.0.0.1 is allowed in DEBUG builds only.
