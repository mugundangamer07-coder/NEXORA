# ---- Backend ----
# A long random string used to sign login tokens. Change this.
JWT_SECRET=change-me-to-a-long-random-string
# Port the API server listens on (frontend dev proxy expects 3001).
PORT=3001

# ---- AI (optional) ----
# Server-side Google Gemini key. Get one at https://aistudio.google.com/app/apikey
# Leave blank to run fully on the bundled offline sample (topic map + question bank).
# The key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
