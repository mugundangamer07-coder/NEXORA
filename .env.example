# ---- Backend ----
# A long random string used to sign login tokens. Required — on Vercel or with
# NODE_ENV=production the server refuses to start without it (no insecure default).
JWT_SECRET=change-me-to-a-long-random-string
# Port the API server listens on (frontend dev proxy expects 3001). Ignored on Vercel.
PORT=3001

# ---- Database (optional, required for persistence on Vercel) ----
# Local dev / Render: leave both blank — the app uses a real SQLite file on
# disk (data/nexora.db), exactly like before.
# Vercel: Vercel's filesystem is read-only and ephemeral, so a hosted libSQL/
# Turso database is required for uploads, accounts and assessments to persist
# across requests. Free database: https://turso.tech -> create a database ->
# `turso db show <name> --url` and `turso db tokens create <name>`.
# Without these on Vercel, the app still runs (falls back to a /tmp file) so
# the seeded demo accounts always work, but new data won't survive a cold start.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- AI (optional) ----
# Server-side Google Gemini key. Get one at https://aistudio.google.com/app/apikey
# Leave blank to run fully on the bundled offline sample (topic map + question bank).
# The key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
